{
  "builds": [
    {
      "src": "erp-system/app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "erp-system/**",
          "instance/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "erp-system/app.py"
    }
  ]
}

